@model NexusApp.Models.ConnectionFormData
@{
    ViewData["Title"] = "NEXUS - Apply for New Connection";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;font-family:Arial,sans-serif;color:#345879;background:#eef5fb}body{overflow:hidden}.page{height:100vh;display:flex;flex-direction:column;background:linear-gradient(135deg,#f4f9fd,#eaf3fa)}
.topbar{height:64px;flex:none;display:flex;align-items:center;padding:0 24px;color:#fff;background:linear-gradient(#062543,#001426);box-shadow:0 2px 8px #123b5928}.logo{font-size:25px;letter-spacing:2px;font-weight:700}.nav{margin-left:auto;display:flex;align-items:center;gap:30px}.nav a{font-size:11px;color:#dceeff;text-decoration:none}.search{width:31px;height:31px;border:1px solid #3980b8;border-radius:6px;display:grid;place-items:center;font-size:20px;color:#b9e0ff}
.layout{min-height:0;flex:1;display:grid;grid-template-columns:260px 1fr}.sidebar{padding:20px 14px;background:linear-gradient(180deg,#f2f8fc,#f8fbfd);border-right:1px solid #dce8f1}.steps{list-style:none;margin:0;padding:0}.step{height:58px;display:flex;align-items:center;gap:12px;padding:0 12px;border-radius:9px;color:#8299ab;font-size:13px;cursor:pointer;position:relative}.step:hover{background:#eaf5ff;color:#2380d8}.step.active{background:#e4f2ff;color:#1578d5;font-weight:700}.step:not(:last-child):after{content:"";position:absolute;left:25px;top:39px;width:1px;height:27px;background:#cbdde9}.num{height:25px;width:25px;display:grid;place-items:center;border:1px solid #c3d5e2;border-radius:50%;background:#fff;font-size:12px;z-index:1}.active .num{color:#fff;background:#1585e9;border-color:#1585e9;box-shadow:0 0 0 4px #d8efff}.done .num{font-size:0;color:#fff;background:#26ad76;border-color:#26ad76}.done .num:after{content:'✓';font-size:13px}
.main{min-width:0;display:flex;align-items:flex-start;justify-content:center;padding:42px 30px}.card{width:min(100%,700px);min-height:430px;padding:25px 27px 20px;border:1px solid #dbe8f1;border-radius:11px;background:rgba(255,255,255,.9);box-shadow:0 5px 17px #3973951c}.title{margin:0 0 22px;color:#174c72;font-size:22px;font-weight:700}.section{display:none}.section.active{display:block;animation:appear .22s ease}@keyframes appear{from{opacity:.2;transform:translateY(5px)}to{opacity:1;transform:none}}.label{display:block;margin:0 0 8px;font-size:13px;font-weight:700;color:#416785}.group{margin-bottom:17px}.radios{display:flex;gap:35px;margin:2px 0 18px}.radio{display:flex;align-items:center;gap:9px;font-size:13px;cursor:pointer}.radio input{appearance:none;width:15px;height:15px;margin:0;border:2px solid #bdcfdb;border-radius:50%;background:#fff}.radio input:checked{border-color:#1688ec;box-shadow:inset 0 0 0 3px #fff;background:#1688ec}.field{width:100%;height:40px;padding:0 12px;border:1px solid #d8e5ee;border-radius:8px;background:#fff;color:#345879;outline:0;font-size:13px}.field:focus{border-color:#1688ec;box-shadow:0 0 0 3px #dff1ff}.summary{display:grid;grid-template-columns:1fr 1fr;gap:10px}.summary div{padding:13px;border-radius:8px;background:#f2f8fc;border:1px solid #e1edf4}.summary small{display:block;color:#8299ab;font-size:11px;margin-bottom:3px}.summary b{font-size:13px;color:#245477}.buttons{display:flex;justify-content:space-between;margin-top:32px;padding-top:18px;border-top:1px solid #edf2f6}.btn{height:40px;min-width:110px;border-radius:7px;padding:0 22px;border:1px solid #dce8f0;background:#fff;color:#638198;font-weight:600;cursor:pointer}.next{border:0;color:#fff;background:linear-gradient(100deg,#1289ed,#0866cf);box-shadow:0 4px 10px #1687e833}.message{position:fixed;right:22px;bottom:22px;padding:13px 18px;border-radius:7px;color:#fff;background:#18a66d;display:none}
@@media(max-width:700px){body{overflow:auto}.topbar{height:58px;padding:0 15px}.logo{font-size:21px}.nav{gap:12px}.nav a{display:none}.layout{display:block}.sidebar{padding:9px 8px;border-right:0;border-bottom:1px solid #dce8f1}.steps{display:flex;overflow-x:auto;gap:6px}.step{min-width:150px;height:43px;border:1px solid #dce8f1}.step:not(:last-child):after{display:none}.main{padding:18px 12px}.card{padding:21px 17px}.summary{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="page">
<header class="topbar"><div class="logo">NEXUS</div><nav class="nav"><a href="#">Home</a><a href="#">Services</a><a href="#">Plans</a><a href="#">Support</a><div class="search">⌕</div></nav></header>
<div class="layout">
<aside class="sidebar"><ul class="steps"><li class="step active" data-step="1"><span class="num">1</span><span>Service Type</span></li><li class="step" data-step="2"><span class="num">2</span><span>Plan Selection</span></li><li class="step" data-step="3"><span class="num">3</span><span>Customer Details</span></li><li class="step" data-step="4"><span class="num">4</span><span>Address &amp; Documents</span></li><li class="step" data-step="5"><span class="num">5</span><span>Review &amp; Submit</span></li></ul></aside>
<main class="main"><div class="card"><h1 class="title">Apply for New Connection</h1>
<section class="section active" data-section="1"><div class="group"><label class="label">Service Type</label><div class="radios"><label class="radio"><input type="radio" name="service" value="Dial-Up" checked />Dial-Up</label><label class="radio"><input type="radio" name="service" value="Broadband" />Broadband</label></div></div></section>
<section class="section" data-section="2"><div class="group"><label class="label" for="plan">Plan</label><select id="plan" class="field"><option value="">Select Plan</option><option>Basic Plan</option><option>Standard Plan</option><option>Premium Plan</option></select></div></section>
<section class="section" data-section="3"><div class="group"><label class="label" for="name">Customer Name</label><input id="name" class="field" placeholder="Enter full name" /></div><div class="group"><label class="label" for="phone">Phone No.</label><input id="phone" class="field" placeholder="Enter phone number" /></div></section>
<section class="section" data-section="4"><div class="group"><label class="label" for="address">Address</label><input id="address" class="field" placeholder="Enter complete address" /></div><div class="group"><label class="label" for="city">City</label><input id="city" class="field" placeholder="Enter city" /></div><div class="group"><label class="label" for="file">Documents</label><input id="file" class="field" type="file" /></div></section>
<section class="section" data-section="5"><div class="summary"><div><small>Service Type</small><b id="rService">Dial-Up</b></div><div><small>Plan</small><b id="rPlan">Not selected</b></div><div><small>Customer Name</small><b id="rName">Not provided</b></div><div><small>Phone No.</small><b id="rPhone">Not provided</b></div></div></section>
<div class="buttons"><button class="btn" id="back" type="button">Cancel</button><button class="btn next" id="next" type="button">Next</button></div>
</div></main></div></div><div class="message" id="message">Application submitted successfully!</div>
<script>
let current=1;const total=5,sections=document.querySelectorAll('.section'),steps=document.querySelectorAll('.step'),back=document.getElementById('back'),next=document.getElementById('next');
function show(n){current=n;sections.forEach(x=>x.classList.toggle('active',+x.dataset.section===n));steps.forEach(x=>{let v=+x.dataset.step;x.classList.toggle('active',v===n);x.classList.toggle('done',v<n)});back.textContent=n===1?'Cancel':'Back';back.style.visibility=n===1?'hidden':'visible';next.textContent=n===5?'Submit':'Next';if(n===5){rService.textContent=document.querySelector('input[name=service]:checked').value;rPlan.textContent=plan.value||'Not selected';rName.textContent=name.value||'Not provided';rPhone.textContent=phone.value||'Not provided'}}
steps.forEach(x=>x.onclick=()=>show(+x.dataset.step));next.onclick=()=>{if(current<total)show(current+1);else{document.getElementById('message').style.display='block';fetch('/Home/SubmitForm',{method:'POST'}).catch(()=>{});setTimeout(()=>document.getElementById('message').style.display='none',2500)}};back.onclick=()=>current===1?location.reload():show(current-1);show(1);
</script>
</body></html>