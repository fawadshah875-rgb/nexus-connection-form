@model NexusApp.Models.ConnectionFormData
@{
    ViewData["Title"] = "NEXUS - New Connection Application";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --header-bg: linear-gradient(135deg, #020b15 0%, #0a1f35 100%);
            --primary: #1689f0;
            --primary-hover: #0d75d8;
            --primary-light: #e3f2ff;
            --success: #10b981;
            --error: #ef4444;
            --text: #1e3a5f;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --bg-page: linear-gradient(135deg, #e8f2fc 0%, #f0f6fb 100%);
            --bg-card: rgba(255, 255, 255, 0.92);
            --bg-sidebar: rgba(255, 255, 255, 0.08);
            --border: #cbd5e1;
            --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.08);
            --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.12);
            --shadow-lg: 0 16px 40px rgba(15, 23, 42, 0.16);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            font-size: 14px;
            line-height: 1.6;
        }

        body {
            background: var(--bg-page);
            color: var(--text);
            min-height: 100vh;
        }

        .container {
            width: 100%;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ============ HEADER ============ */
        .header {
            height: 72px;
            background: var(--header-bg);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            box-shadow: var(--shadow-md);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-logo {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: rgba(22, 137, 240, 0.15);
            border: 2px solid rgba(22, 137, 240, 0.4);
            display: grid;
            place-items: center;
            color: #5bb3ff;
            font-weight: 900;
            font-size: 22px;
            letter-spacing: -1px;
        }

        .header-title {
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 1px;
        }

        .header-nav {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .header-nav a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: color 0.3s ease;
            cursor: pointer;
        }

        .header-nav a:hover {
            color: #64b5f6;
        }

        .header-search {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.05);
            display: grid;
            place-items: center;
            color: rgba(255, 255, 255, 0.7);
            font-size: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .header-search:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.3);
        }

        /* ============ CONTENT ============ */
        .content {
            flex: 1;
            display: grid;
            grid-template-columns: 280px 1fr;
            overflow: hidden;
        }

        /* ============ SIDEBAR ============ */
        .sidebar {
            background: rgba(255, 255, 255, 0.04);
            border-right: 1px solid rgba(0, 0, 0, 0.08);
            padding: 32px 16px;
            overflow-y: auto;
            box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.1);
        }

        .sidebar-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 24px;
            padding: 0 12px;
        }

        .steps-list {
            list-style: none;
        }

        .step-item {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            margin-bottom: 8px;
            border-radius: 10px;
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .step-item:hover {
            background: rgba(22, 137, 240, 0.08);
            color: #2563eb;
        }

        .step-item.active {
            background: rgba(22, 137, 240, 0.12);
            color: var(--primary);
            font-weight: 600;
        }

        .step-number {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: white;
            border: 2px solid #e2e8f0;
            display: grid;
            place-items: center;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-secondary);
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .step-item.active .step-number {
            background: var(--primary);
            border-color: var(--primary);
            color: white;
            box-shadow: 0 0 0 6px rgba(22, 137, 240, 0.15);
        }

        .step-item.completed .step-number {
            background: var(--success);
            border-color: var(--success);
            color: white;
            font-size: 0;
        }

        .step-item.completed .step-number::after {
            content: '✓';
            font-size: 16px;
        }

        .step-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 47px;
            top: 46px;
            width: 2px;
            height: 16px;
            background: linear-gradient(to bottom, #cbd5e1, transparent);
        }

        /* ============ MAIN ============ */
        .main {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            overflow-y: auto;
        }

        .form-wrapper {
            width: 100%;
            max-width: 820px;
            animation: slideUp 0.4s ease;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-card {
            background: var(--bg-card);
            border-radius: 16px;
            border: 1px solid rgba(203, 213, 225, 0.8);
            box-shadow: var(--shadow-lg);
            padding: 48px;
            position: relative;
            overflow: hidden;
        }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary) 0%, #06b6d4 100%);
        }

        .form-header {
            margin-bottom: 28px;
        }

        .form-eyebrow {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary);
            margin-bottom: 8px;
        }

        .form-title {
            font-size: 28px;
            font-weight: 800;
            color: var(--text);
            margin: 0;
            letter-spacing: -0.5px;
        }

        /* ============ FORM SECTIONS ============ */
        .form-section {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .form-section.active {
            display: block;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 10px;
            letter-spacing: 0.3px;
        }

        .radio-group {
            display: flex;
            gap: 32px;
            margin-top: 12px;
        }

        .radio-item {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
        }

        .radio-input {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid #cbd5e1;
            background: white;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }

        .radio-input:hover {
            border-color: var(--primary);
        }

        .radio-item input:checked ~ .radio-input {
            border-color: var(--primary);
            background: var(--primary);
            box-shadow: 0 0 0 4px rgba(22, 137, 240, 0.1);
        }

        .radio-item input:checked ~ .radio-input::after {
            content: '';
            position: absolute;
            inset: 4px;
            background: white;
            border-radius: 50%;
        }

        .radio-item input {
            display: none;
        }

        .radio-label {
            font-size: 14px;
            color: var(--text);
            margin: 0;
        }

        .input, select {
            width: 100%;
            height: 44px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0 14px;
            font-size: 14px;
            color: var(--text);
            background: rgba(248, 250, 252, 0.8);
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .input::placeholder {
            color: var(--text-muted);
        }

        .input:hover, select:hover {
            border-color: #cbd5e1;
            background: rgba(248, 250, 252, 1);
        }

        .input:focus, select:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 3px rgba(22, 137, 240, 0.1);
        }

        .input.error {
            border-color: var(--error);
            background: rgba(239, 68, 68, 0.03);
        }

        .input.error:focus {
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

        /* ============ REVIEW SECTION ============ */
        .review-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .review-item {
            padding: 16px;
            background: rgba(22, 137, 240, 0.04);
            border: 1px solid rgba(22, 137, 240, 0.12);
            border-radius: 10px;
        }

        .review-label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .review-value {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

        /* ============ BUTTONS ============ */
        .button-group {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            margin-top: 36px;
            padding-top: 28px;
            border-top: 1px solid #e2e8f0;
        }

        .btn {
            min-width: 140px;
            height: 44px;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.3px;
            font-family: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-secondary {
            background: white;
            color: #64748b;
            border: 1.5px solid #e2e8f0;
        }

        .btn-secondary:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: var(--text);
        }

        .btn-secondary:active {
            transform: scale(0.98);
        }

        .btn-primary {
            background: linear-gradient(135deg, #1689f0 0%, #0d75d8 100%);
            color: white;
            box-shadow: 0 8px 20px rgba(22, 137, 240, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(22, 137, 240, 0.4);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        /* ============ SUCCESS MESSAGE ============ */
        .success-banner {
            position: fixed;
            top: 20px;
            right: 20px;
            background: white;
            border-left: 4px solid var(--success);
            padding: 16px 20px;
            border-radius: 8px;
            box-shadow: var(--shadow-lg);
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideInRight 0.4s ease;
            z-index: 1000;
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(400px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .success-icon {
            color: var(--success);
            font-size: 20px;
            font-weight: 900;
        }

        .success-text {
            color: var(--text);
            font-size: 14px;
            font-weight: 600;
        }

        /* ============ RESPONSIVE ============ */
        @@media (max-width: 1024px) {
            .header {
                padding: 0 24px;
            }

            .form-card {
                padding: 40px;
            }

            .review-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .content {
                grid-template-columns: 1fr;
            }

            .sidebar {
                padding: 12px 8px;
                border-right: none;
                border-bottom: 1px solid rgba(0, 0, 0, 0.08);
            }

            .sidebar-title {
                display: none;
            }

            .steps-list {
                display: flex;
                gap: 8px;
                overflow-x: auto;
                padding-bottom: 8px;
            }

            .step-item {
                min-width: 160px;
                margin-bottom: 0;
                border: 1px solid #e2e8f0;
            }

            .step-item:not(:last-child)::before {
                display: none;
            }

            .main {
                padding: 24px 16px;
            }

            .form-card {
                padding: 28px;
            }

            .form-title {
                font-size: 24px;
            }
        }

        @@media (max-width: 480px) {
            .header {
                height: 64px;
                padding: 0 16px;
            }

            .header-title {
                font-size: 22px;
            }

            .header-nav a {
                display: none;
            }

            .header-logo {
                width: 38px;
                height: 38px;
                font-size: 18px;
            }

            .main {
                padding: 16px 12px;
            }

            .form-card {
                padding: 20px;
            }

            .form-title {
                font-size: 20px;
            }

            .button-group {
                flex-direction: column-reverse;
                margin-top: 24px;
            }

            .btn {
                width: 100%;
                min-width: auto;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header class="header">
            <div class="header-brand">
                <div class="header-logo">N</div>
                <div class="header-title">NEXUS</div>
            </div>
            <nav class="header-nav">
                <a href="#">Home</a>
                <a href="#">Services</a>
                <a href="#">Plans</a>
                <a href="#">Support</a>
                <div class="header-search">⌕</div>
            </nav>
        </header>

        <!-- CONTENT -->
        <div class="content">
            <!-- SIDEBAR -->
            <aside class="sidebar">
                <div class="sidebar-title">Progress</div>
                <ul class="steps-list">
                    <li class="step-item active" data-step="1">
                        <span class="step-number">1</span>
                        <span>Service Type</span>
                    </li>
                    <li class="step-item" data-step="2">
                        <span class="step-number">2</span>
                        <span>Plan Selection</span>
                    </li>
                    <li class="step-item" data-step="3">
                        <span class="step-number">3</span>
                        <span>Customer Details</span>
                    </li>
                    <li class="step-item" data-step="4">
                        <span class="step-number">4</span>
                        <span>Address & Documents</span>
                    </li>
                    <li class="step-item" data-step="5">
                        <span class="step-number">5</span>
                        <span>Review & Submit</span>
                    </li>
                </ul>
            </aside>

            <!-- MAIN -->
            <main class="main">
                <div class="form-wrapper">
                    <div class="form-card">
                        <div class="form-header">
                            <div class="form-eyebrow">Step <span id="currentStepNum">1</span> of 5</div>
                            <h1 class="form-title">Apply for New Connection</h1>
                        </div>

                        <form id="connectionForm">
                            <!-- STEP 1: Service Type -->
                            <div class="form-section active" data-step="1">
                                <div class="form-group">
                                    <label>Select Service Type</label>
                                    <div class="radio-group">
                                        <div class="radio-item">
                                            <input type="radio" id="dialup" name="service" value="Dial-Up" checked />
                                            <span class="radio-input"></span>
                                            <label for="dialup" class="radio-label">Dial-Up Connection</label>
                                        </div>
                                        <div class="radio-item">
                                            <input type="radio" id="broadband" name="service" value="Broadband" />
                                            <span class="radio-input"></span>
                                            <label for="broadband" class="radio-label">Broadband Internet</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- STEP 2: Plan Selection -->
                            <div class="form-section" data-step="2">
                                <div class="form-group">
                                    <label for="plan">Choose Your Plan</label>
                                    <select id="plan" class="input">
                                        <option value="">Select Plan</option>
                                        <option value="Basic - $19/month">Basic Plan - $19/month</option>
                                        <option value="Standard - $39/month" selected>Standard Plan - $39/month</option>
                                        <option value="Premium - $69/month">Premium Plan - $69/month</option>
                                    </select>
                                </div>
                            </div>

                            <!-- STEP 3: Customer Details -->
                            <div class="form-section" data-step="3">
                                <div class="form-group">
                                    <label for="name">Full Name *</label>
                                    <input type="text" id="name" class="input" placeholder="Enter your full name" />
                                </div>
                                <div class="form-group">
                                    <label for="phone">Phone Number *</label>
                                    <input type="tel" id="phone" class="input" placeholder="+92 300 1234567" />
                                </div>
                                <div class="form-group">
                                    <label for="email">Email Address *</label>
                                    <input type="email" id="email" class="input" placeholder="example@email.com" />
                                </div>
                            </div>

                            <!-- STEP 4: Address & Documents -->
                            <div class="form-section" data-step="4">
                                <div class="form-group">
                                    <label for="address">Complete Address *</label>
                                    <input type="text" id="address" class="input" placeholder="Enter installation address" />
                                </div>
                                <div class="form-group">
                                    <label for="city">City *</label>
                                    <input type="text" id="city" class="input" placeholder="Enter city name" />
                                </div>
                                <div class="form-group">
                                    <label for="postal">Postal Code</label>
                                    <input type="text" id="postal" class="input" placeholder="Enter postal code" />
                                </div>
                            </div>

                            <!-- STEP 5: Review -->
                            <div class="form-section" data-step="5">
                                <div class="review-grid">
                                    <div class="review-item">
                                        <div class="review-label">Service Type</div>
                                        <div class="review-value" id="reviewService">Dial-Up</div>
                                    </div>
                                    <div class="review-item">
                                        <div class="review-label">Plan</div>
                                        <div class="review-value" id="reviewPlan">Select Plan</div>
                                    </div>
                                    <div class="review-item">
                                        <div class="review-label">Full Name</div>
                                        <div class="review-value" id="reviewName">-</div>
                                    </div>
                                    <div class="review-item">
                                        <div class="review-label">Phone</div>
                                        <div class="review-value" id="reviewPhone">-</div>
                                    </div>
                                    <div class="review-item">
                                        <div class="review-label">Email</div>
                                        <div class="review-value" id="reviewEmail">-</div>
                                    </div>
                                    <div class="review-item">
                                        <div class="review-label">City</div>
                                        <div class="review-value" id="reviewCity">-</div>
                                    </div>
                                </div>
                            </div>

                            <!-- BUTTONS -->
                            <div class="button-group">
                                <button type="button" class="btn btn-secondary" id="backBtn" style="visibility: hidden;">
                                    ← Back
                                </button>
                                <button type="button" class="btn btn-primary" id="nextBtn">
                                    Next →
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- SUCCESS BANNER -->
    <div id="successBanner" class="success-banner" style="display: none;">
        <div class="success-icon">✓</div>
        <div class="success-text">Application submitted successfully!</div>
    </div>

    <script>
        let currentStep = 1;
        const totalSteps = 5;

        const stepItems = document.querySelectorAll('.step-item');
        const sections = document.querySelectorAll('.form-section');
        const currentStepNum = document.getElementById('currentStepNum');
        const backBtn = document.getElementById('backBtn');
        const nextBtn = document.getElementById('nextBtn');
        const form = document.getElementById('connectionForm');

        function goToStep(step) {
            if (step < 1 || step > totalSteps) return;

            // Update sections
            sections.forEach(section => {
                section.classList.toggle('active', Number(section.dataset.step) === step);
            });

            // Update sidebar
            stepItems.forEach(item => {
                const itemStep = Number(item.dataset.step);
                item.classList.toggle('active', itemStep === step);
                item.classList.toggle('completed', itemStep < step);
            });

            currentStep = step;
            currentStepNum.textContent = step;
            backBtn.style.visibility = step === 1 ? 'hidden' : 'visible';

            if (step === totalSteps) {
                nextBtn.textContent = '✓ Submit Application';
                updateReview();
            } else {
                nextBtn.textContent = 'Next →';
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function validateStep(step) {
            const errors = [];

            if (step === 3) {
                const name = document.getElementById('name').value.trim();
                const phone = document.getElementById('phone').value.trim();
                const email = document.getElementById('email').value.trim();

                if (!name) {
                    document.getElementById('name').classList.add('error');
                    errors.push('Name is required');
                } else {
                    document.getElementById('name').classList.remove('error');
                }

                if (!phone) {
                    document.getElementById('phone').classList.add('error');
                    errors.push('Phone is required');
                } else {
                    document.getElementById('phone').classList.remove('error');
                }

                if (!email) {
                    document.getElementById('email').classList.add('error');
                    errors.push('Email is required');
                } else {
                    document.getElementById('email').classList.remove('error');
                }
            }

            if (step === 4) {
                const address = document.getElementById('address').value.trim();
                const city = document.getElementById('city').value.trim();

                if (!address) {
                    document.getElementById('address').classList.add('error');
                    errors.push('Address is required');
                } else {
                    document.getElementById('address').classList.remove('error');
                }

                if (!city) {
                    document.getElementById('city').classList.add('error');
                    errors.push('City is required');
                } else {
                    document.getElementById('city').classList.remove('error');
                }
            }

            return errors.length === 0;
        }

        function updateReview() {
            document.getElementById('reviewService').textContent = document.querySelector('input[name="service"]:checked').value;
            document.getElementById('reviewPlan').textContent = document.getElementById('plan').value || 'Not selected';
            document.getElementById('reviewName').textContent = document.getElementById('name').value || '-';
            document.getElementById('reviewPhone').textContent = document.getElementById('phone').value || '-';
            document.getElementById('reviewEmail').textContent = document.getElementById('email').value || '-';
            document.getElementById('reviewCity').textContent = document.getElementById('city').value || '-';
        }

        nextBtn.addEventListener('click', (e) => {
            e.preventDefault();

            if (currentStep < totalSteps) {
                if (!validateStep(currentStep)) return;
                goToStep(currentStep + 1);
            } else {
                if (!validateStep(5)) return;

                fetch('/Home/SubmitForm', { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('successBanner').style.display = 'flex';
                            form.style.opacity = '0.5';
                            setTimeout(() => {
                                window.location.href = '/';
                            }, 2000);
                        }
                    })
                    .catch(err => console.error('Error:', err));
            }
        });

        backBtn.addEventListener('click', (e) => {
            e.preventDefault();
            if (currentStep > 1) goToStep(currentStep - 1);
        });

        stepItems.forEach(item => {
            item.addEventListener('click', () => {
                const step = Number(item.dataset.step);
                if (step <= currentStep) {
                    goToStep(step);
                }
            });
        });

        goToStep(1);
    </script>
</body>
</html>